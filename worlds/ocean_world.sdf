<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ocean_world">
  
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <!-- WGS84 center of the WindFloat Atlantic bathymetry export. -->
      <latitude_deg>41.686526</latitude_deg>
      <longitude_deg>-9.057421</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.225</density> 
        </density_change>
      </graded_buoyancy>
      <enable>vessel_v2::base_link</enable>
      <enable>uuv_bluerov2_heavy::base_link</enable>
      <enable>durius::base_link</enable>
      <enable>floating_windturbine::platform</enable>
      <enable>nautilus_vessel::base_link</enable>
    </plugin>

    <model name="water_plane">
      <static>true</static>
      <pose>0 0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>7000 7000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.6 0.4</ambient>
            <diffuse>0.0 0.3 0.6 0.4</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- The highest vertex in the seabed STL is at z=-66.23535 m. -->
    <include>
      <uri>model://ocean_depths</uri>
      <pose>0 0 56.23535 0 0 0</pose>
    </include>

    <include>
      <uri>model://floating_windturbine</uri>
    </include>
  </world>
</sdf>
