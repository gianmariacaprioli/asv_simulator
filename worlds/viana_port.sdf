<?xml version="1.0"?>
<sdf version="1.9">
  <world name="viana_port">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <!-- The STL has no georeference. Its local origin is anchored to DURIUS. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>41.685703</latitude_deg>
      <longitude_deg>-8.838577</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
      <enable>vessel_v2::base_link</enable>
      <enable>uuv_bluerov2_heavy::base_link</enable>
      <enable>nautilus_vessel::base_link</enable>
    </plugin>

    <include>
      <uri>model://viana_port_terrain</uri>
    </include>

    <!-- Fixed inspection target, with its bottom above the local seabed. -->
    <include>
      <uri>model://durius</uri>
      <name>durius</name>
      <pose>0 0 1.8 0 0 0</pose>
      <static>true</static>
    </include>

    <model name="water_plane">
      <static>true</static>
      <link name="link">
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.6 0.4</ambient>
            <diffuse>0.0 0.3 0.6 0.4</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  </world>
</sdf>
