<?xml version="1.0"?>
<sdf version="1.9">
  <model name="durius">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <pose>0 0 1.8 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <!-- Centre of gravity 3 m below the geometric centre. -->
        <pose>0 0 -3.0 0 0 0</pose>
        <mass>1995000</mass>
        <inertia>
          <ixx>64300000</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>64300000</iyy>
          <iyz>0</iyz>
          <izz>77400000</izz>
        </inertia>
      </inertial>

      <!--
        The primitive is deliberately used for collision and buoyancy. It is
        stable, inexpensive and exactly matches DURIUS_parameters.txt.
      -->
      <collision name="floater_collision">
        <geometry>
          <cylinder>
            <radius>8.8</radius>
            <length>12.4</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!--
        The supplied STL is already in metres and measures approximately
        17.84 x 17.17 x 12.38 m. Its bounds are recentered on the cylinder.
      -->
      <visual name="floater_visual">
        <pose>-0.623164 0.279401 -0.023381 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///root/vessel_ws/usv_simulator_files/DURIUS_simplified.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.38 0.42 1</ambient>
          <diffuse>0.55 0.58 0.62 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-50000</xU>
      <xUabsU>-60000</xUabsU>
      <yV>-50000</yV>
      <yVabsV>-60000</yVabsV>
      <zW>-100000</zW>
      <zWabsW>-80000</zWabsW>
      <kP>-5000000</kP>
      <mQ>-5000000</mQ>
      <nR>-5000000</nR>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>durius/odom</odom_frame>
      <robot_base_frame>durius/base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
