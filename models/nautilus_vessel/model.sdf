<?xml version="1.0"?>
<sdf version="1.9">
  <model name="nautilus_vessel">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <!-- Provisional thrust curve for simulation checkout. -->
    <!-- Actuators.velocity uses signed commands in [-1, 1], port then starboard. -->
    <plugin filename="libGenericMotorModelPlugin.so" name="gz::sim::systems::GenericMotorModel">
      <jointName>propeller_left_joint</jointName>
      <linkName>propeller_left_link</linkName>
      <actuator_number>0</actuator_number>
      <turningDirection>ccw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>force_polynomial</motorType>
      <controlMethod>rpm</controlMethod>
      <maxRotVelocity>1</maxRotVelocity>
      <rotorVelocitySlowdownSim>0.05</rotorVelocitySlowdownSim>
      <thrustAxis>1 0 0</thrustAxis>
      <positiveThrustPolynomial>[0, 150, 0, 0]</positiveThrustPolynomial>
      <negativeThrustPolynomial>[0, 150, 0, 0]</negativeThrustPolynomial>
    </plugin>
    <plugin filename="libGenericMotorModelPlugin.so" name="gz::sim::systems::GenericMotorModel">
      <jointName>propeller_right_joint</jointName>
      <linkName>propeller_right_link</linkName>
      <actuator_number>1</actuator_number>
      <turningDirection>cw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorType>force_polynomial</motorType>
      <controlMethod>rpm</controlMethod>
      <maxRotVelocity>1</maxRotVelocity>
      <rotorVelocitySlowdownSim>0.05</rotorVelocitySlowdownSim>
      <thrustAxis>1 0 0</thrustAxis>
      <positiveThrustPolynomial>[0, 150, 0, 0]</positiveThrustPolynomial>
      <negativeThrustPolynomial>[0, 150, 0, 0]</negativeThrustPolynomial>
    </plugin>

    <!-- Equilibrium height for 260 kg on the buoyancy boxes in seawater. -->
    <pose>0 0 0.098 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <!-- CAD CG (0, -0.1, -0.05) transformed into the body frame. -->
        <pose>0.1 0 -0.05 0 0 0</pose>
        <!-- Two 1 g propeller links keep total model mass equal to 260 kg. -->
        <mass>259.998</mass>
        <inertia>
          <!-- CAD X/Y moments swap under the CAD-to-body rotation. -->
          <ixx>187.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>88.0</iyy>
          <iyz>0</iyz>
          <izz>215.0</izz>
        </inertia>
      </inertial>

      <!-- Separate fore and aft volumes restore pitch in Gazebo 8.15,
           where the buoyancy plugin slices each shape along its local Z axis.
           Their longitudinal center matches the center of mass. -->
      <collision name="port_forward_collision">
        <pose>0.775 0.52 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.35 0.40 0.43</size>
          </box>
        </geometry>
      </collision>

      <collision name="port_aft_collision">
        <pose>-0.575 0.52 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.35 0.40 0.43</size>
          </box>
        </geometry>
      </collision>

      <collision name="starboard_forward_collision">
        <pose>0.775 -0.52 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.35 0.40 0.43</size>
          </box>
        </geometry>
      </collision>

      <collision name="starboard_aft_collision">
        <pose>-0.575 -0.52 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.35 0.40 0.43</size>
          </box>
        </geometry>
      </collision>

      <visual name="hull_visual">
        <!-- Align the assembled CAD to the shaft axis and buoyancy-box keel.
             The exported hull already contains both visible motor assemblies. -->
        <pose>-0.404 0 -0.470 0 0 1.094045</pose>
        <geometry>
          <mesh>
            <uri>model://nautilus_vessel/meshes/nautilus_vessel_hull_simplified.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.32 0.48 1</ambient>
          <diffuse>0.18 0.48 0.70 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <link name="propeller_left_link">
      <pose>-1.530 0.345 -0.3355 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="propeller_left_visual">
        <!-- The propeller STL shaft is on CAD Y. Rotate it onto body X. -->
        <pose>0 0 0 0 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://nautilus_vessel/meshes/nautilus_propeller_left.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="propeller_right_link">
      <pose>-1.530 -0.345 -0.3355 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="propeller_right_visual">
        <!-- The propeller STL shaft is on CAD Y. Rotate it onto body X. -->
        <pose>0 0 0 0 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://nautilus_vessel/meshes/nautilus_propeller_right.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="propeller_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>propeller_left_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="propeller_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>propeller_right_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!--
      Gazebo Harmonic's Hydrodynamics system uses signed damping derivatives.
      Only the supplied linear and quadratic terms are included; no added mass
      or propulsion coefficients are invented here.
    -->
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-100</xU>
      <xUabsU>-55</xUabsU>
      <yV>-250</yV>
      <yVabsV>-220</yVabsV>
      <zW>-400</zW>
      <zWabsW>-300</zWabsW>
      <kP>-150</kP>
      <kPabsP>-120</kPabsP>
      <mQ>-200</mQ>
      <mQabsQ>-180</mQabsQ>
      <nR>-120</nR>
      <nRabsR>-140</nRabsR>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/nautilus_vessel/joint_state</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>nautilus_vessel/odom</odom_frame>
      <robot_base_frame>nautilus_vessel/base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
